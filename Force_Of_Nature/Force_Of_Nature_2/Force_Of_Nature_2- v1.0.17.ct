          <Description>"Build Item ID reference [Activation: Open Build Menu &gt; Pick Item]"</Description>
          <Options moHideChildren="1"/>
          <LastState/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

aobscanmodule(ref,GameAssembly.dll,48 63 83 38 01 00 00) // should be unique
alloc(newmem,$1000,ref)
alloc(_ref1,8)
alloc(_ref2,8)
alloc(_ref3,8)
alloc(_ref4,8)
alloc(_ref5,8)
alloc(_ref6,8)
alloc(refcopy,7)
registersymbol(ref)
registersymbol(_ref1)
registersymbol(_ref2)
registersymbol(_ref3)
registersymbol(_ref4)
registersymbol(_ref5)
registersymbol(_ref6)
registersymbol(refcopy)
label(first)
label(second)
label(third)
label(fourth)
label(fifth)
label(sixth)
label(code)
label(return)

refcopy:
  readmem(ref,7)
newmem:
  cmp [rbx+00000138],0
  je first
  cmp [rbx+00000138],1
  je second
  cmp [rbx+00000138],2
  je third
  cmp [rbx+00000138],3
  je fourth
  cmp [rbx+00000138],4
  je fifth
  cmp [rbx+00000138],5
  je sixth
  jmp code
first:
  mov [_ref1],rbx
  jmp code
second:
  mov [_ref2],rbx
  jmp code
third:
  mov [_ref3],rbx
  jmp code
fourth:
  mov [_ref4],rbx
  jmp code
fifth:
  mov [_ref5],rbx
  jmp code
sixth:
  mov [_ref6],rbx
  jmp code
code:
  readmem(ref,7)
  jmp return

ref:
  jmp newmem
  nop 2
return:

[DISABLE]
ref:
  readmem(refcopy,7)
unregistersymbol(*)
dealloc(*)

</AssemblerScript>
