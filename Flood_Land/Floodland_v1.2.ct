    <CheatEntry>
      <ID>104783</ID>
      <Description>"      [ Activar ] - { Haga clic Para Activar } - [v1.0.20970]"</Description>
      <Color>0000FF</Color>
      <Options moHideChildren="0"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : Floodland.exe
  Version: 1.1.0
  Date   : 2025-12-27
  Author : BabyGroot,HaRrY

}

[ENABLE]

{$lua}

OpenProcess("Floodland.exe")
mono_initialize()
if (LaunchMonoDataCollector())==0
then error ('Falla en el lanzamiento')
end

{$asm}

[DISABLE]

</AssemblerScript>
      <CheatEntries>
