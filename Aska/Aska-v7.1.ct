    <CheatEntry>
      <ID>1302</ID>
      <Description>"Instant Max Out necesita presionar [F4] en Juego"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

aobscanmodule(needsmax,GameAssembly.dll,F3 0F 10 41 28 F3 0F 5C C3 F3 0F 5E) // Debe ser única
alloc(newmem,$100,needsmax)

label(code)
label(return)

newmem:
  mov [rcx+28],(float)100

code:
  movss xmm0,[rcx+28]
  jmp return

needsmax:
  jmp newmem
return:
registersymbol(needsmax)

[DISABLE]

needsmax:
  db F3 0F 10 41 28

unregistersymbol(needsmax)
dealloc(needsmax)

</AssemblerScript>
