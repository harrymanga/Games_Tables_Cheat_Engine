    </CheatEntry>
    <CheatEntry>
      <ID>105351</ID>
      <Description>"Inf HP + Inf Stamina + 2 Hits kill"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : Aska.exe
  Version: 
  Date   : 2024-06-22
  Author : LIOBOSS

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(INJECT,GameAssembly.dll,F3 0F 11 73 28 48 85 C0 ?? ?? 48 8B 50 28) // Debe ser única
alloc(newmem,$1000,INJECT)

label(player)
label(code)
label(stamina)
label(enemy)
label(return)

newmem:
  cmp [rbx+10],#2201 // Stamina ID check
  je stamina
  cmp r13,1  // Sin daños en la caída de salto de altura
  je player
  cmp rsi,0  // EnemigOs
  je enemy
  cmp r10,2  // Nido de criaturas en el suelo
  je enemy
  cmp r10,B1 // HP Jugador
  je player

code:
  movss [rbx+28],xmm6
  jmp return

player:
  push eax
  mov eax,#99999
  cvtsi2ss xmm6,eax
  pop eax
  movss [rbx+28],xmm6
  jmp return

stamina:
  movss xmm6,[rbx+44]
  jmp code

enemy:
  push eax
  mov eax,1
  cvtsi2ss xmm6,eax
  pop eax
  // don't xorps xmm6,xmm6 --&gt; it's buggy
  movss [rbx+28],xmm6
  jmp return



INJECT:
  jmp newmem
return:
registersymbol(INJECT)

[DISABLE]

INJECT:
  db F3 0F 11 73 28

unregistersymbol(INJECT)
dealloc(newmem)

{
// Código original: punto de inyección: GameAssembly.dll.il2cpp+239B28A

GameAssembly.dll.il2cpp+239B267: 48 8B 43 30     - mov rax,[rbx+30]
GameAssembly.dll.il2cpp+239B26B: 48 85 C0        - test rax,rax
GameAssembly.dll.il2cpp+239B26E: 74 4B           - je GameAssembly.dll.il2cpp+239B2BB
GameAssembly.dll.il2cpp+239B270: 48 8B 50 28     - mov rdx,[rax+28]
GameAssembly.dll.il2cpp+239B274: 48 8B 48 40     - mov rcx,[rax+40]
GameAssembly.dll.il2cpp+239B278: 0F 28 74 24 20  - movaps xmm6,[rsp+20]
GameAssembly.dll.il2cpp+239B27D: 48 83 C4 30     - add rsp,30
GameAssembly.dll.il2cpp+239B281: 5B              - pop rbx
GameAssembly.dll.il2cpp+239B282: 48 FF 60 18     - jmp qword ptr [rax+18]
GameAssembly.dll.il2cpp+239B286: 48 8B 43 18     - mov rax,[rbx+18]
// ---------- INJECTING HERE ----------
GameAssembly.dll.il2cpp+239B28A: F3 0F 11 73 28  - movss [rbx+28],xmm6
// ---------- DONE INJECTING  ----------
GameAssembly.dll.il2cpp+239B28F: 48 85 C0        - test rax,rax
GameAssembly.dll.il2cpp+239B292: 74 0B           - je GameAssembly.dll.il2cpp+239B29F
GameAssembly.dll.il2cpp+239B294: 48 8B 50 28     - mov rdx,[rax+28]
GameAssembly.dll.il2cpp+239B298: 48 8B 48 40     - mov rcx,[rax+40]
GameAssembly.dll.il2cpp+239B29C: FF 50 18        - call qword ptr [rax+18]
GameAssembly.dll.il2cpp+239B29F: 48 8B 43 20     - mov rax,[rbx+20]
GameAssembly.dll.il2cpp+239B2A3: 48 85 C0        - test rax,rax
GameAssembly.dll.il2cpp+239B2A6: 74 13           - je GameAssembly.dll.il2cpp+239B2BB
GameAssembly.dll.il2cpp+239B2A8: 4C 8B 48 28     - mov r9,[rax+28]
GameAssembly.dll.il2cpp+239B2AC: F3 0F 10 53 28  - movss xmm2,[rbx+28]
}

</AssemblerScript>
