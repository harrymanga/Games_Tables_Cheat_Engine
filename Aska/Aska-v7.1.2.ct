      <AssemblerScript>[ENABLE]

aobscanmodule(INJECT,GameAssembly.dll,F3 0F 10 51 2C 45 33 C9 8B) // Debe ser única
alloc(newmem,$1000,INJECT)
alloc(speed,8)

label(code)
label(return)

