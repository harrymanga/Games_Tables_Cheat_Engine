    <CheatEntry>
      <ID>1</ID>
      <Description>"1) ¡Activar! junto el proceso del juego y lance el coleccionista de datos mono"</Description>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : Aska.exe
  Version: *.*.*
  Date   : 2025-07-10
  Author : LIOBOSS , BigBear743 , Harry

}

[ENABLE]

{$lua}
OpenProcess("Aska.exe")
mono_initialize()
if (LaunchMonoDataCollector())==0
then error ('Falla en el lanzamiento')
end
{$asm}

[DISABLE]

</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>54</ID>
      <Description>"2) Iniciar/cargar un juego nuevo o guardado y luego esperar para tomar el control de tu personaje"</Description>
      <Color>FF0000</Color>
      <GroupHeader>1</GroupHeader>
