              <ID>105338</ID>
              <Description>"Nivel de habilidad rápida (realice una acción para actualizar el multiplicador)"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[Activar]
aobscanmodule(fastskilllevelup,GameAssembly.dll,1B 48 8B 17 48 8B CF 48 8B 82 78 01 00 00) // Debe ser única
alloc(fastskilllevelupnewmem,$100,fastskilllevelup)
alloc(skillmult,$20,fastskilllevelup)

label(fastskilllevelupcode)
label(fastskilllevelupreturn)

skillmult:
  dq (float)80
fastskilllevelupnewmem:
  mov rcx,rdi  //código original

  movss xmm15,[skillmult]
  movss [rcx+28],xmm15  //Cambiar 99 a lo que quieras, número más alto = más rápido
  movss xmm15,xmm14

fastskilllevelupcode:
  mov rax,[rdx+00000178] //código original
  jmp fastskilllevelupreturn

fastskilllevelup+04:
  jmp fastskilllevelupnewmem
  nop 5
fastskilllevelupreturn:
registersymbol(fastskilllevelup skillmult)

