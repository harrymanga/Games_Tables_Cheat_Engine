        <CheatEntry>
          <ID>105415</ID>
          <Description>"Item duplicating multiplier (change stack size to 80)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[Activar]
aobscanmodule(itemmult,GameAssembly.dll,01 51 30 8B 41 30) // Debe ser única
alloc(itemmultnewmem,$400,itemmult)
alloc(itemmultvar,$16,itemmult)

label(itemmultcode)
label(itemmultreturn)

itemmultvar:
  dd (int)3

itemmultnewmem:
  //eliminate unwanted values
  cmp edx,#4
  jle itemmultnewmem+325
  cmp edx,#99
  jge itemmultnewmem+325

  //pointer == [[rcx+10]+10]+28]+18]
  push rax
  push rbx
  mov rbx,0000FFFFFFFFFFFF

  mov rax,[rcx+10]  //actual script

  //pointer protector
  cmp rax,rbx
  jnl itemmultnewmem+250
  cmp rax,0
  je itemmultnewmem+250

  mov rax,[rax+10] //actual script

  //pointer protector
  cmp rax,rbx
  jnl itemmultnewmem+250
  cmp rax,0
  je itemmultnewmem+250

  mov rax,[rax+28] //actual script

  //pointer protector
  cmp rax,rbx
  jnl itemmultnewmem+250
  cmp rax,0
  je itemmultnewmem+250

  cmp [rax+18],#0 //player+villager inventory

  je itemmultnewmem+175
  jmp itemmultnewmem+250

itemmultnewmem+175:
  imul edx,[itemmultvar]
  pop rax
  pop rbx
  jmp itemmultnewmem+325

itemmultnewmem+250:
  pop rax
  pop rbx
  jmp itemmultnewmem+325

itemmultnewmem+325:
  add [rcx+30],edx
  cmp [rcx+30],#80
  jle itemmultcode
  mov [rcx+30],#80
  jmp itemmultcode

itemmultcode:
  mov eax,[rcx+30]
  jmp itemmultreturn

itemmult:
  jmp itemmultnewmem
  nop
itemmultreturn:
registersymbol(itemmult itemmultvar)

//================change stack size============
aobscanmodule(stacksize,GameAssembly.dll,8B 43 2C 48 83 C4 20 5F) // Debe ser única
alloc(stacksizenewmem,$100,stacksize)

label(stacksizecode)
label(stacksizereturn)

stacksizenewmem:
//  cmp [rbx+120],#1 //#1==large items
//  jne stacksizecode
  cmp [rbx+D0],#1 //1==tools/weapon
  je stacksizecode
  mov [rbx+2C],#80  //change 80 to whatever number you like
  jmp stacksizecode
stacksizecode:
  mov eax,[rbx+2C]
  add rsp,20
  jmp stacksizereturn

stacksize:
  jmp stacksizenewmem
  nop 2
stacksizereturn:
registersymbol(stacksize)

