[Desactivar]

</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>105409</ID>
              <Description>"Cambiar el tamaño del inventario (moviendo los elementos)"</Description>
              <Options moHideChildren="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[Activar]
aobscanmodule(invsizechanger,GameAssembly.dll,48 8B F9 44 3B 41 20) // Debe ser única
alloc(invsizechangernewmem,$100,invsizechanger)
alloc(invsize,$16,invsizechanger)

label(invsizechangercode)
label(invsizechangerreturn)

invsize:
  dq 0
invsizechangernewmem:
  mov rdi,rcx
  cmp r9,0
  jne invsizechangercode
      push rax
      mov rax,[rcx+10]
      cmp [rax+1C],0  //0 = inventory
      pop rax
      jne invsizechangercode
      mov [invsize],rcx

invsizechangercode:
  cmp r8d,[rcx+20]
  jmp invsizechangerreturn

invsizechanger:
  jmp invsizechangernewmem
  nop 2
invsizechangerreturn:
registersymbol(invsizechanger invsize)

[Desactivar]
//Código desde aquí hasta el final del código se usará para deshabilitar el truco
invsizechanger:
  db 48 8B F9 44 3B 41 20

unregistersymbol(*)
dealloc(*)

