    <CheatEntry>
      <ID>17</ID>
      <Description>"Stamina Script (walk a little)"</Description>
      <LastState Activated="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscan(AOB_Stamina,D9 00 D9 5D E8 D9 45 E8 DD) // should be unique D9 18 8B 46 10 40 89 46 10 8D 65 FC  D9 18 8B 46 10
alloc(newmem,$1000)
alloc(pStamina,4)
alloc(pStaminaIsSet,4)
label(newStamina)
label(codeStamina)
label(returnStamina)

registersymbol(AOB_Stamina)
registersymbol(pStaminaIsSet)
registersymbol(pStamina)

newmem:

newStamina:
  cmp [pStaminaIsSet],1
  je codeStamina
  mov [pStamina],eax
  jmp codeStamina
codeStamina:
  fld dword ptr [eax]
  fstp dword ptr [ebp-18]
  jmp returnStamina

AOB_Stamina:
  jmp newStamina
returnStamina:


[DISABLE]
AOB_Stamina:
  db D9 00 D9 5D E8

unregistersymbol(AOB_Stamina)
unregistersymbol(pStamina)
unregistersymbol(pStaminaIsSet)
dealloc(pStaminaIsSet)
dealloc(pStamina)
dealloc(newmem)

