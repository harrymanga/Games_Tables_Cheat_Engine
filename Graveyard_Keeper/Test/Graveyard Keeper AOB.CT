    <CheatEntry>
      <ID>24</ID>
      <Description>"Character Script (walk a little)"</Description>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscan(AOB_Character,D9 40 10 D9 5D FC) // should be unique
alloc(newmem,$1000)
alloc(pCharacter,4)

label(newCharacter)
label(codeCharacter)
label(returnCharacter)

registersymbol(AOB_Character)
registersymbol(pCharacter)

newmem:

newCharacter:
  mov [pCharacter],eax
  jmp codeCharacter
codeCharacter:
  fld dword ptr [eax+10]
  fstp dword ptr [ebp-04]
  jmp returnCharacter

AOB_Character:
  jmp newCharacter
  nop
returnCharacter:


[DISABLE]
AOB_Character:
  db D9 40 10 D9 5D FC

unregistersymbol(AOB_Character)
unregistersymbol(pCharacter)
dealloc(pCharacter)
dealloc(newmem)

