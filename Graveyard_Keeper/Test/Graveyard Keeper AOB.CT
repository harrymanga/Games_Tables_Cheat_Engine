        <CheatEntry>
          <ID>1057</ID>
          <Description>"Give 100% stamina"</Description>
          <LastState/>
          <Color>FF00FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
local pointer = readQword( "pStamina" )
if ( ( pointer == nil ) or ( pointer == 0 ) ) then
  showMessage("Stamina pointer not loaded...")
  error()
end
--print( string.format( "pointer: %X8", pointer ) )
local offset = 0x198
writeFloat(pointer-offset,100)
{$asm}
[DISABLE]

