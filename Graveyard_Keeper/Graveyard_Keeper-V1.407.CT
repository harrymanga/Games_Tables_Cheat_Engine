    <CheatEntry>
      <ID>5</ID>
      <Description>"Stamina, Inventario, Velocidad (Activa y pierde stamina. STM debe ser &gt;90 y &lt;100)"</Description>
      <Color>408000</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

aobscan(AOB_Stamina,D9 18 8B 46 10 40 89 46 10 8D 65 FC) // should be unique
alloc(newmem,$1000)
alloc(pStamina,4)
alloc(pStaminaIsSet,4)
alloc(stVal,4)
label(codeStamina)
label(returnStamina)

registersymbol(AOB_Stamina)
registersymbol(pStaminaIsSet)
registersymbol(stVal)
registersymbol(pStamina)

newmem:
  cmp [pStaminaIsSet],1
  je codeStamina
  fst dword ptr [stVal]
  cmp [stVal], (float)90.0
  jl codeStamina
  cmp [stVal], (float)98.0
  jg codeStamina
  mov [pStamina],eax
  mov [pStaminaIsSet],1
  jmp codeStamina

codeStamina:
  fstp dword ptr [eax]
  mov eax,[esi+10]
  jmp returnStamina

AOB_Stamina:
  jmp newmem
returnStamina:

[DISABLE]

AOB_Stamina:
  db D9 18 8B 46 10

unregistersymbol(AOB_Stamina)
unregistersymbol(pStamina)
unregistersymbol(pStaminaIsSet)
unregistersymbol(stVal)
dealloc(pStaminaIsSet)
dealloc(pStamina)
dealloc(newmem)
dealloc(stVal)

