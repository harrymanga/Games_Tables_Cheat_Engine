      <ID>24</ID>
      <Description>"Script de personaje (camina un poco)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscan(AOB_Character,D9 40 10 D9 5D FC) // should be unique
