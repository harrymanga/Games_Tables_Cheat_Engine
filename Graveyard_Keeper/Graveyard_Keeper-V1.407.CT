    <CheatEntry>
      <ID>104783</ID>
      <Description>"      [ Activar ] - { Haga clic Para Activar } - [V.1.407]"</Description>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{======================
Game   : Graveyard Keeper.exe
Version: 1.407
Date   : 20026-05-23
Author : slavka , HaRrY
======================}

[ENABLE]

{$lua}

if syntaxcheck then return end

-----------------------
memrec.Color=0x000000ff
-------------- A.B.G.R

OpenProcess("Graveyard Keeper.exe")

if(process == nil) then
   ShowMessage('No se seleccionó ningún proceso')
elseif (string.upper(process) ~= string.upper("Graveyard Keeper.exe")) then
   ShowMessage('Advertencia. Proceso esperado = Graveyard Keeper.exe')
end

mono_initialize()

if (LaunchMonoDataCollector())==0 then
 ShowMessage('Falla en el lanzamiento de Mono')
end

{$asm}

[DISABLE]

{$lua}

if syntaxcheck then return end

-----------------------
memrec.Color=0x00808000
-------------- A.B.G.R 

{$asm}

</AssemblerScript>
    </CheatEntry>
