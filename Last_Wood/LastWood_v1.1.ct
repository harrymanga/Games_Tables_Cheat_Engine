label(code)
label(return)

label(ccInfo)
registersymbol(ccInfo)

newmem:

code:
  mov [ccInfo],rax
  movsxd  rcx,dword ptr [rax+68]
  sub ecx,r15d
  jmp return

ccInfo:
dq

address:
  jmp newmem
  nop 2
return:

[DISABLE]

address:
  db bytes
  // movsxd  rcx,dword ptr [rax+68]
  // sub ecx,r15d

dealloc(newmem)
unregistersymbol(ccInfo)


</AssemblerScript>
