        <CheatEntry NoCheckbox="1">
          <ID>104788</ID>
          <Description>"+++ SCRIPT +++"</Description>
          <Color>FF0000</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>104914</ID>
              <Description>"Artículo de almacenamiento ilimitado"</Description>
              <Color>FF0000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]

aobscan(pData_3,48 63 47 14 44 03 F8) // should be unique
alloc(newmem,$1000,pData_3)

label(code)
label(return)

newmem:
  mov dword ptr [rdi+14],#10

code:
  movsxd  rax,dword ptr [rdi+14]
  add r15d,eax
  jmp return

pData_3:
  jmp newmem
  nop 2
return:
registersymbol(pData_3)

[DISABLE]

pData_3:
  db 48 63 47 14 44 03 F8

unregistersymbol(pData_3)
dealloc(newmem)


</AssemblerScript>
