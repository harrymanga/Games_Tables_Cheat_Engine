{$lua}
if syntaxcheck then return end
if wildEightFloat then return end
registerCustomTypeLua("Wild Eight Float", 4,
function(b1,b2,b3,b4,a)
  local v1 = readInteger(a - 4)
  local bt = { b1, b2, b3, b4 }
  local v2 = byteTableToDword(bt)
  v2 = bXor(v2, v1)
  v2 = dwordToByteTable(v2)
  return byteTableToFloat(v2)
end,
function(i,a)
  local v = readInteger(a - 4)
  i = floatToByteTable(i)
  i = byteTableToDword(i)
  i = bXor(i, v)
  i = dwordToByteTable(i)
  return unpack(i)
end, true)
registerCustomTypeLua("Wild Eight Int", 4,
function(b1,b2,b3,b4,a)
  local v1 = readInteger(a - 4)
  local bt = { b1, b2, b3, b4 }
  local v2 = byteTableToDword(bt)
  v2 = bXor(v2, v1)
  return v2
end,
function(i,a)
  local v = readInteger(a - 4)
  i = bXor(i, v)
  i = dwordToByteTable(i)
  return unpack(i)
end, false)
wildEightFloat = true
{$asm}

