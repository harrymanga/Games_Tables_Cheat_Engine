      <ID>120</ID>
      <Description>"Ignore Hunger/Warmth"</Description>
      <LastState Activated="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">//StatEffect:PerformUpdate+1b0
[ENABLE]
aobscan(ignoreStatus,C1 48 8B C8 F2 0F 10 C8 F2 0F 5A C9 83 38 00 66 66 90 49 BB ?? ?? ?? ?? ?? ?? ?? ?? 41 FF D3 48)
alloc(newmem,$1000,ignoreStatus)

label(code)
label(return)
label(run)

newmem:
  cmp [rax+40],#6 // warmth
  je run
  cmp [rax+40],#7 // hunger
  je run
  jmp code
run:
  movss xmm0,[rax+44]
  cvtss2sd xmm0,xmm0
code:
  movsd xmm1,xmm0
  cvtsd2ss xmm1,xmm1
  jmp return

