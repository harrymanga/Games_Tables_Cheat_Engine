    <CheatEntry>
      <ID>85</ID>
      <Description>"Punteros"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript Async="1">//BrandNewUI:StatBarHUD:OnStatChanged+6f
[ENABLE]
aobscan(hud,FF 48 8B 47 78 48 8B C8)
alloc(newmem,$1000,hud)

label(code)
label(return)
label(hudPtr)

newmem:
  mov rax,hudPtr
  mov [rax],rdi
code:
  mov rax,[rdi+78]
  mov rcx,rax
  jmp return

hudPtr:
  dq 0

hud+01:
  jmp newmem
  nop 2
return:
registersymbol(hud)
registersymbol(hudPtr)

{$lua}
if syntaxcheck then return end
if wildEightFloat then return end
registerCustomTypeLua("Wild Eight Float", 4,
function(b1,b2,b3,b4,a)
  local v1 = readInteger(a - 4)
  local bt = { b1, b2, b3, b4 }
  local v2 = byteTableToDword(bt)
  v2 = bXor(v2, v1)
  v2 = dwordToByteTable(v2)
  return byteTableToFloat(v2)
end,
function(i,a)
  local v = readInteger(a - 4)
  i = floatToByteTable(i)
  i = byteTableToDword(i)
  i = bXor(i, v)
  i = dwordToByteTable(i)
  return unpack(i)
end, true)
registerCustomTypeLua("Wild Eight Int", 4,
function(b1,b2,b3,b4,a)
  local v1 = readInteger(a - 4)
  local bt = { b1, b2, b3, b4 }
  local v2 = byteTableToDword(bt)
  v2 = bXor(v2, v1)
  return v2
end,
function(i,a)
  local v = readInteger(a - 4)
  i = bXor(i, v)
  i = dwordToByteTable(i)
  return unpack(i)
end, false)
wildEightFloat = true
{$asm}

[DISABLE]
hud+01:
  db 48 8B 47 78 48 8B C8
unregistersymbol(hud)
unregistersymbol(hudPtr)
dealloc(newmem)

