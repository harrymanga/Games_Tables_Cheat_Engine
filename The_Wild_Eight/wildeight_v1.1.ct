    <CheatEntry>
      <ID>1</ID>
      <Description>"¡Activar! Carga el juego y el coleccionista de datos mono"</Description>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : wildeight.exe
  Version: *.*.*
  Date   : 2025-08-02
  Author : Zanzer, Harry

}

[ENABLE]

{$lua}
OpenProcess("wildeight.exe")
mono_initialize()
if (LaunchMonoDataCollector())==0
then error ('Falla en el lanzamiento')
end
{$asm}

[DISABLE]

</AssemblerScript>
