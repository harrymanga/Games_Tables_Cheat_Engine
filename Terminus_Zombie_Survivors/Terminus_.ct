    <CheatEntry>
      <ID>51297</ID>
      <Description>"Get Character"</Description>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
function readField(list)
  local result,result2,k,pointer={},{}
  local max=readInteger(list+0x10)
  for i=0,0x100 do
    if #result&gt;=max then break end
    pointer=readPointer(list+i*4+0x10)
    if pointer%4==0  then
      pointer=readString(pointer+0x18)
      if pointer and pointer:len()&gt;1 and pointer:find('%w') then
        k=i*4+0x10 break
      end
    end
  end
  for i=0,0x100 do
    if #result&gt;=max then break end
    pointer=readPointer(list+i*0xC+k)
    if pointer%4==0  then
      pointer=readString(pointer+0x18)
      if pointer and pointer:len()&gt;1 then
        result[#result+1]=pointer
        result2[#result]=i*0xC+k+4
      end
    end
  end
  return result,result2
end

function readType(object)
  if not readPointer(object) then return '' end
  local pointer,name=readPointer(readPointer(object+0x4)+0xC)

  name=readString(pointer)

  if not name then name=''end
  if name:find('type') then name=readString(readPointer(object+0xC)) end
  return name
end

function populatePython(mrec)
  local object=mrec.CurrentAddress
  --printf('%X',object)
  if not readPointer(object) then return end
  --if readInteger(object+4)~=0 then object=readPointer(object)end
  local typ,typ2,rec,tec,pointer=readType(object)
  if typ=='dict' then
    rec = getAddressList().createMemoryRecord()
    rec.setAddress(string.format('%s+8',mrec.Address))
    rec.setDescription('count')
    rec.appendToEntry(mrec)
    rec.DontSave=true
    rec.Type=vtDword
    rec = getAddressList().createMemoryRecord()
    local flag1=readPointer(readPointer(object+0x1C))
    rec.setAddress(string.format(( flag1 and '%s+1C' or '%s+18'),mrec.Address))
    rec.OffsetCount=1
    rec.Offset[0]=0
    rec.setDescription('entries')
    rec.appendToEntry(mrec)
    rec.DontSave=true
    rec.Type=vtByte
    rec.IsAddressGroupHeader=true
    rec.Options='[moHideChildren]'
    local field,field2=readField(readPointer(object+0x18))
    if #field&gt;0 then
      for i=0,#field-1 do
        tec = getAddressList().createMemoryRecord()
        tec.setAddress(string.format('[[%s]+%X]',rec.Address,(flag1 and i*4 or field2[i+1]) ))
        tec.setDescription(string.format('[%03X] %s',(flag1 and i*4 or field2[i+1]),field[i+1]))
        tec.appendToEntry(rec)
        tec.DontSave=true
        tec.Type=vtDword
        tec.ShowAsHex=true
        local ftyp=readType(tec.CurrentAddress)
        if ftyp=='dict' then
          tec.Type=vtByte tec.IsAddressGroupHeader=true
          tec.OnDeactivate=load([[
    return
    function(memrec,before,currentstate)
      for i=memrec.Count-1,0,-1 do
        memoryrecord_delete(memrec.Child[i])
      end
    return true
    end]])()
          tec.OnActivate=load([[
    return
    function(memrec,before,currentstate)
      for i=memrec.Count-1,0,-1 do
        memoryrecord_delete(memrec.Child[i])
      end
      populatePython(memrec)
      return true
    end
    ]])()
        else
          populatePython(tec)
          tec.setAddress(string.format('[%s]+%X',rec.Address,(flag1 and i*4 or field2[i+1]) ))
        end
      end
    end
  elseif typ=='list' then
    rec = getAddressList().createMemoryRecord()
    rec.setAddress(string.format('%s+8',mrec.Address))
    rec.setDescription('count')
    rec.appendToEntry(mrec)
    rec.DontSave=true
    rec.Type=vtDword
    local count=readInteger(rec.CurrentAddress)
    rec = getAddressList().createMemoryRecord()
    local flag1=readPointer(readPointer(object+0x1C))
    rec.setAddress(string.format('%s+C',mrec.Address))
    rec.OffsetCount=1
    rec.Offset[0]=0
    rec.setDescription('list')
    rec.appendToEntry(mrec)
    rec.DontSave=true
    rec.Type=vtByte
    rec.IsAddressGroupHeader=true
    if count&gt;50 then rec.Options='[moHideChildren]' end
    for i=0,count-1 do
      tec = getAddressList().createMemoryRecord()
      tec.setAddress(string.format('[[%s]+%X]',rec.Address,i*4))
      tec.appendToEntry(rec)
      tec.DontSave=true
      tec.Type=vtDword tec.ShowAsHex=true
      tec.setDescription(readType(tec.CurrentAddress))


      tec.setAddress(string.format('[[[%s]+%X]+8]',rec.Address,i*4))
        --populatePython(tec)
      tec.Type=vtByte tec.IsAddressGroupHeader=true
      tec.OnDeactivate=load([[
    return
    function(memrec,before,currentstate)
      for i=memrec.Count-1,0,-1 do
        memoryrecord_delete(memrec.Child[i])
      end
    return true
    end]])()

       tec.OnActivate=load([[
    return
    function(memrec,before,currentstate)
      for i=memrec.Count-1,0,-1 do
        memoryrecord_delete(memrec.Child[i])
      end
      populatePython(memrec)
      return true
    end
    ]])()

    end

  else
    rec = getAddressList().createMemoryRecord()
    if typ:find('float')then
      rec.setAddress(string.format('%s+8',mrec.Address))
      rec.Type=vtDouble
    elseif typ:find('int')then
      rec.setAddress(string.format('%s+C',mrec.Address))
      rec.Type=vtDword
    elseif typ:find('str')then
      rec.setAddress(string.format('%s+18',mrec.Address))
      rec.Type=vtString rec.String.Size=0x100
    else rec.setAddress(string.format('%s+C',mrec.Address)) rec.Type=vtDword end
    rec.setDescription(typ)
    rec.appendToEntry(mrec)
    rec.DontSave=true

  end
end
function cycleFullCompact(sender,force)
  local state = not(compactmenuitem.Caption == 'Compact View Mode')
  if force~=nil then state = not force end
  compactmenuitem.Caption = state and 'Compact View Mode' or 'Full View Mode'
  getMainForm().Splitter1.Visible = state
  getMainForm().Panel4.Visible = state
  getMainForm().Panel5.Visible = state
end
function addCompactMenu()
  if compactmenualreadyexists then return end
  local parent = getMainForm().Menu.Items
  compactmenuitem = createMenuItem(parent)
  parent.add(compactmenuitem)
  compactmenuitem.Caption = 'Compact View Mode'
  compactmenuitem.OnClick = cycleFullCompact
  compactmenualreadyexists = 'yes'
end
addCompactMenu()

if syntaxcheck then return end
for i=memrec.Count-1,0,-1 do
  memoryrecord_delete(memrec.Child[i])
end

{$asm}
[ENABLE]
{$lua}

if syntaxcheck then return end
local rec=getAddressList().createMemoryRecord()
rec.setAddress('[[Character]+8]')
rec.Type=vtByte rec.IsAddressGroupHeader=true
rec.OnDeactivate=load([[
    return
    function(memrec,before,currentstate)
      for i=memrec.Count-1,0,-1 do
        memoryrecord_delete(memrec.Child[i])
      end
    return true
    end]])()

rec.OnActivate=load([[
    return
    function(memrec,before,currentstate)
      for i=memrec.Count-1,0,-1 do
        memoryrecord_delete(memrec.Child[i])
      end
      populatePython(memrec)
      return true
    end
    ]])()
rec.setDescription('Character')
rec.appendToEntry(memrec)
rec.DontSave=true

{$asm}
assert("python37.dll"+F8700,55 8B EC 83 E4 F8)
alloc(newmem,2048)
label(returnhere)
label(Character)
registersymbol(Character)
newmem:
mov eax,[esp+4]
test eax,eax
je short @f
mov eax,[eax+4]
test eax,eax
je short @f
mov eax,[eax+C]
test eax,eax
je short @f
cmp [eax],'Char'
jne short @f
cmp [eax+4],'acte'
jne short @f
mov eax,[esp+4]
mov [Character],eax

@@:
push ebp
mov ebp,esp
and esp,-08
jmp returnhere
Character:
dq 0 0
"python37.dll"+F8700:
jmp newmem
nop
returnhere:

[DISABLE]
dealloc(newmem)
"python37.dll"+F8700:
//push ebp
//mov ebp,esp
//and esp,-08
db 55 8B EC 83 E4 F8
unregistersymbol(Character)
</AssemblerScript>
