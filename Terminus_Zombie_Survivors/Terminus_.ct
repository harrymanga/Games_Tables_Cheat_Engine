if not readPointer(pytho)then
  pytho=AOBScanUnique('* * * * * * * * 00 00 00 00 00 00 00 00 * * * * * * * * 01 00 00 00 01 00 00 00 * * * * * * * * 01 00 00 00 02 00 00 00 * * * * * * * * 01 00 00 00 03 00 00 00')
end
valuefinderr=true
valuefinder = createTimer()
valuefinder.setInterval(300)
valuefinder.OnTimer = function()
  if not valuefinderr then valuefinder.destroy() return end
  local value=getAddressSafe('pytho')
  if(value~=nil)then writePointer(_valuefinder+0x8,value+readInteger(_valuefinder)*0x10)end
end
[DISABLE]

