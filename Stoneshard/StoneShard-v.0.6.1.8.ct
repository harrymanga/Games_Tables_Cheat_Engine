_CoinOnBag.onTimer = function()
--------------------------------------------
    GoldValue = ('["CoinOnBag"]+10')
    Coin = 2000
if( GoldValue &lt; Coin )
then
    print("Gold coin kurang 2000")
	--writeDouble('["CoinOnBag"]+10',2000)
else
   print("Gold coin wes 2000")
end

--------------------------------------------
end

