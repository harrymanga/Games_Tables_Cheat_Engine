      <Description>"             [Activar] - {Haga clic Para Activar} - [v.0.6.1.8]"</Description>
      <Color>808000</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{======================
Game   : StoneShard.exe
Version: 0.6.1.8
Date   : 2025-11-15
Author : aanpsx , HaRrY
======================}

[ENABLE]

{$lua}

if syntaxcheck then return end

-----------------------
memrec.Color=0x000000ff
-------------- A.B.G.R

OpenProcess("StoneShard.exe")

if(process == nil) then
   ShowMessage('No se seleccionó ningún proceso')
elseif (string.upper(process) ~= string.upper("StoneShard.exe")) then
   ShowMessage('Advertencia. Proceso esperado = StoneShard.exe')
end

--mono_initialize()

--if (LaunchMonoDataCollector())==0 then
----ShowMessage('Falla en el lanzamiento de Mono')
--end

{$asm}
s
[DISABLE]

{$lua}

if syntaxcheck then return end

-----------------------
memrec.Color=0x00808000
-------------- A.B.G.R 

{$asm}

</AssemblerScript>
